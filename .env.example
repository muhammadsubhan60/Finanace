# Public URL of the app (no trailing slash). Production: https://ops.ecom.deltalabs.tech
APP_URL=http://localhost:3000
# MongoDB replica set (transactions required). `pnpm db:start` starts one on 27018 for development.
MONGODB_URI="mongodb://127.0.0.1:27018/?replicaSet=rs0&directConnection=true"
MONGODB_DB=delta_finance
ORG_ID=delta-labs
# 32 bytes hex/base64 — encrypts integration credentials (AES-256-GCM). `openssl rand -hex 32`
APP_ENCRYPTION_KEY=
# Seed password for all demo users (change after first login)
SEED_PASSWORD=ChangeMe!2026
# Where uploaded receipts/CSVs are stored (local disk default; S3/R2 adapter is the swap point)
UPLOAD_DIR=./uploads
# TCS Connect bearer token (from the TCS Connect portal)
TCS_BEARER_TOKEN=
